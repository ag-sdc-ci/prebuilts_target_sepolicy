# Generated by bp2ninja (Standalone Android.bp to Ninja Converter)
# Dependency checks bypassed for rapid standalone iteration

ninja_required_version = 1.7.0
builddir = out
top = .

cc = clang
cxx = clang++
ar = llvm-ar
aapt2 = aapt2

rule cc_compile
  command = $cc -MD -MF $out.d $cflags $includes -c $in -o $out
  description = CC $out
  depfile = $out.d
  deps = gcc

rule cxx_compile
  command = $cxx -MD -MF $out.d $cflags $includes -c $in -o $out
  description = CXX $out
  depfile = $out.d
  deps = gcc

rule link_shared
  command = $cxx -shared -o $out $in $ldflags $libs
  description = LINK_SHARED $out

rule link_binary
  command = $cxx -o $out $in $ldflags $libs
  description = LINK_BINARY $out

rule archive_static
  command = rm -f $out && $ar rcs $out $in
  description = AR $out

rule copy
  command = cp -f $in $out
  description = COPY $out

rule copy_executable
  command = cp -f $in $out && chmod +x $out
  description = COPY_BIN $out

rule genrule_cmd
  command = bash -c "$cmd"
  description = GEN $out

build out/gen/aosp_selinux_flags/aosp_selinux_flags.stamp: phony
build out/gen/all_selinux_flags/all_selinux_flags.stamp: phony

default out/gen/aosp_selinux_flags/aosp_selinux_flags.stamp out/gen/all_selinux_flags/all_selinux_flags.stamp
